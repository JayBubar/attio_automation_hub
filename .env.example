# Copy to .env for local runs. On Railway, set these in the service's
# Variables tab instead -- never commit a real .env file.

# --- already in use by the webhook routes ---
ATTIO_API_KEY=
SMARTLEAD_WEBHOOK_SECRET=
ACTIVECAMPAIGN_LIST_ID=
MOTHERDUCK_TOKEN=

# --- Ops Center (ops_center_routes.py) ---
# Shared secret gating every trigger/status/task route. Set the SAME value
# on the ops-center Streamlit service.
OPS_CENTER_TOKEN=
# Used by scripts/outreach.py to draft the emails.
ANTHROPIC_API_KEY=
# Used by /status/smartlead.
SMARTLEAD_API_KEY=
SMARTLEAD_CAMPAIGN_ID=
# Defaults to hubspot_email_archive if unset.
MOTHERDUCK_DATABASE=

# --- Microsoft Graph draft creation (graph_mail.py) ---
# From the Entra app registration. Delegated Mail.ReadWrite + User.Read +
# offline_access, with Global Admin tenant consent granted. Redirect URI
# registered as <HUB_PUBLIC_URL>/auth/microsoft/callback.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
HUB_PUBLIC_URL=https://attio-automation-hub-production.up.railway.app
