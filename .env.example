# Copy to .env for local runs. On Railway, set these in the service's
# Variables tab instead -- never commit a real .env file.

# --- already in use by the webhook routes ---
ATTIO_API_KEY=
SMARTLEAD_WEBHOOK_SECRET=
MOTHERDUCK_TOKEN=

# Two different lists in two different systems -- do not set these to the same
# value. ACTIVECAMPAIGN_LIST_ID is AC's numeric list id, used against AC's API
# by scripts/outreach_rotation.py. ATTIO_AC_TARGET_LIST_ID is the Attio list
# UUID for "Current Marketing Prospects in ActiveCampaign"
# (api_slug active_campaign_target_list), used for Attio list membership.
ACTIVECAMPAIGN_LIST_ID=
ATTIO_AC_TARGET_LIST_ID=e65a24d3-711f-410c-94aa-83a4738aaad6

# Attio list "Add to Smartlead" -- the hand-curated intake queue. People here
# are pushed to Smartlead ahead of the Never Contacted pool, and their entry is
# removed once the push succeeds. There is deliberately no equivalent
# ATTIO_SMARTLEAD_TARGET_LIST_ID: the "Smartlead Target List" holds no
# attributes that active_cold_outreach_contact doesn't already carry, so the
# Smartlead path tracks membership with the checkbox alone. See README.
ATTIO_SMARTLEAD_INTAKE_LIST_ID=bb25b08c-a228-40f3-aa64-1fbad9bbfee3

# --- AC tag<->list sync (activecampaign_routes.py) ---
# Automation 15 is meant to carry both the tag-added and tag-removed triggers;
# as of 2026-08-12 only tagadd exists in AC (see README). The route rejects
# payloads from any other seriesid. Leave empty to accept any.
ACTIVECAMPAIGN_SERIES_ID=15
ACTIVECAMPAIGN_MARKETING_TAG=Attio Marketing Contact

# --- AC form fills (form_fill_routes.py) ---
# Optional. If set, all five AC webhook URLs must carry &token=<this value>.
# Unset means the route serves unauthenticated, same as /webhooks/activecampaign.
AC_WEBHOOK_TOKEN=

# --- Ops Center (ops_center_routes.py) ---
# Shared secret gating every trigger/status/task route. Set the SAME value
# on the ops-center Streamlit service.
OPS_CENTER_TOKEN=
# Used by scripts/outreach.py to draft the emails.
ANTHROPIC_API_KEY=
# Used by /status/smartlead.
SMARTLEAD_API_KEY=
SMARTLEAD_CAMPAIGN_ID=
# Defaults to hubspot_email_archive if unset.
MOTHERDUCK_DATABASE=

# --- outreach_rotation.py (daily job) ---
ACTIVECAMPAIGN_API_URL=https://raisetell.api-us1.com
ACTIVECAMPAIGN_API_KEY=
ACTIVECAMPAIGN_TAG_ID=3
ACTIVECAMPAIGN_MAX_CONTACTS=5000
# Days on the tag without engagement before eviction back to Cold/Retry Pending.
ACTIVECAMPAIGN_STALE_DAYS=45
# Starting value for the AC pause flag. The Ops Center toggle (stored in
# MotherDuck) overrides this -- see automation_config.py. Defaults to paused
# when neither is set.
AC_PAUSED=true
# Attio slug for the mirrored AC contact id. The attribute does not exist in
# the workspace yet, so leave this EMPTY -- setting it to a slug Attio does not
# have makes every AC push PATCH fail. See README "Manual prerequisites".
ATTIO_AC_CONTACT_ID_SLUG=
DRY_RUN=true

# --- Microsoft Graph draft creation (graph_mail.py) ---
# From the Entra app registration. Delegated Mail.ReadWrite + User.Read +
# offline_access, with Global Admin tenant consent granted. Redirect URI
# registered as <HUB_PUBLIC_URL>/auth/microsoft/callback.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
HUB_PUBLIC_URL=https://attio-automation-hub-production.up.railway.app
